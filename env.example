# Clave de SendGrid para envío de correos
SENDGRID_API_KEY=your_sendgrid_api_key

# Token de acceso a la API de Duffel para reservas de vuelos
DUFFEL_ACCESS_TOKEN=your_duffel_access_token

# Clave secreta de Stripe para pagos
STRIPE_SECRET_KEY=your_stripe_secret_key

# Puerto en el que se ejecuta el servidor (opcional)
PORT=3000
